# Mark Speakeasy-generated code so GitHub collapses diffs in PRs and
# excludes them from language stats. Keep this file in sync with .genignore.
#
# Human-authored sources that remain visible in PRs:
#   - overlay.yaml
#   - .speakeasy/workflow.yaml, .speakeasy/gen.yaml
#   - Makefile, CONTRIBUTING.md, .github/workflows/*
#   - tests/**, *_test.go
#   - the .genignore exceptions re-enabled at the bottom of this file

# --- Generated SDK, provider, and helpers ---
internal/sdk/**            linguist-generated=true
internal/provider/**       linguist-generated=true
internal/planmodifiers/**  linguist-generated=true
internal/validators/**     linguist-generated=true

# --- Generated docs and examples ---
docs/**                    linguist-generated=true
examples/**                linguist-generated=true

# --- Generated top-level files ---
main.go                            linguist-generated=true
go.mod                             linguist-generated=true
go.sum                             linguist-generated=true
tools/tools.go                     linguist-generated=true
.goreleaser.yml                    linguist-generated=true
terraform-registry-manifest.json   linguist-generated=true
original-openapi.json              linguist-generated=true

# --- Speakeasy lockfiles ---
.speakeasy/gen.lock        linguist-generated=true
.speakeasy/workflow.lock   linguist-generated=true

# --- Human-authored exceptions (mirror of .genignore) ---
# These live inside generated trees but are written by hand; keep their
# diffs visible.
tests/**                                                                      linguist-generated=false
internal/**/*_test.go                                                         linguist-generated=false
examples/resources/lumos_access_policy/resource.tf                            linguist-generated=false
examples/resources/lumos_requestable_permission/resource.tf                   linguist-generated=false
internal/sdk/internal/hooks/registration.go                                   linguist-generated=false
internal/validators/objectvalidators/request_config_input_validator.go        linguist-generated=false
